# 웹 판(GitHub Pages) 광고. 이 파일을 .env.production.local 로 복사해(커밋하지 않음) AdSense 에서 받은 값을 넣어요.
# 게시자 ID 가 비어 있으면 웹은 광고 없이 만들어져요.
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# 화면 아래 배너(디스플레이 광고 단위, 320x50). 비우면 판 사이 전면 광고만 나와요.
VITE_ADSENSE_BANNER_SLOT=
# 1 이면 구글 시험 광고만(승인 전 화면 확인용). 올릴 때는 지워요.
VITE_ADSENSE_TEST=
